# Optional DeepSeek analysis; empty key means deterministic rules mode.
# Backend-only. No real keys in git, extension builds, fixtures, issues, or logs.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=12

# Not loaded automatically. Export the variables in the shell that runs uvicorn, e.g.
#   set -a; . apps/api/.env; set +a
#   .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
# Empty or missing LLM_API_KEY keeps /v1/analyze in deterministic rules mode.
# A plaintext http:// base URL is accepted only for loopback hosts.
# Both https://api.deepseek.com and https://api.deepseek.com/v1 are supported.
# DeepSeek thinking is disabled; a single call has no automatic retries.

# Explicit offline demo only: fixture. Default: hibp (public catalogue, no key).
# Export in the API process environment; this file is not loaded automatically.
AMIFOOLED_BREACHES_MODE=hibp
