{
  "name": "amifooled",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/extension"],
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "npm run dev --workspace @amifooled/extension",
    "build": "npm run build --workspace @amifooled/extension",
    "typecheck": "npm run typecheck --workspace @amifooled/extension",
    "test": "npm run test --workspace @amifooled/extension",
    "lint": "eslint apps/extension",
    "contracts:types": "openapi-typescript contracts/openapi.json -o apps/extension/lib/api.generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "openapi-typescript": "7.13.0",
    "typescript-eslint": "^8.46.0"
  }
}
