{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "maxItems": 100,
            "title": "Evidence",
            "type": "array"
          },
          "hostname": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
            "title": "Hostname",
            "type": "string"
          },
          "policy_text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Policy Text",
            "type": "string"
          }
        },
        "required": [
          "hostname",
          "policy_text"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "hostname": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
            "title": "Hostname",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "mode": {
            "enum": [
              "rules",
              "llm",
              "fixture"
            ],
            "title": "Mode",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "insufficient_data",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "hostname",
          "status",
          "mode",
          "summary",
          "findings",
          "limitations"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "Breach": {
        "additionalProperties": false,
        "properties": {
          "breach_date": {
            "format": "date",
            "title": "Breach Date",
            "type": "string"
          },
          "data_classes": {
            "items": {
              "type": "string"
            },
            "title": "Data Classes",
            "type": "array"
          },
          "is_verified": {
            "title": "Is Verified",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "breach_date",
          "data_classes",
          "is_verified",
          "source_url"
        ],
        "title": "Breach",
        "type": "object"
      },
      "BreachesResponse": {
        "additionalProperties": false,
        "properties": {
          "attribution_url": {
            "default": "https://haveibeenpwned.com/",
            "title": "Attribution Url",
            "type": "string"
          },
          "breaches": {
            "items": {
              "$ref": "#/components/schemas/Breach"
            },
            "title": "Breaches",
            "type": "array"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "count": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Count"
          },
          "hostname": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
            "title": "Hostname",
            "type": "string"
          },
          "matched_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Domain"
          },
          "source": {
            "enum": [
              "hibp",
              "fixture"
            ],
            "title": "Source",
            "type": "string"
          },
          "stale": {
            "default": false,
            "title": "Stale",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "not_found",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "hostname",
          "matched_domain",
          "status",
          "count",
          "breaches",
          "checked_at",
          "source"
        ],
        "title": "BreachesResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "resource_domain",
              "visible_cookie_count",
              "policy_excerpt"
            ],
            "title": "Kind",
            "type": "string"
          },
          "limitation": {
            "maxLength": 500,
            "title": "Limitation",
            "type": "string"
          },
          "value": {
            "maxLength": 500,
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "value",
          "limitation"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "policy_quote": {
            "title": "Policy Quote",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning"
            ],
            "title": "Severity",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "explanation",
          "severity",
          "policy_quote",
          "evidence_ids"
        ],
        "title": "Finding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AmIFooled API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/analyze": {
      "post": {
        "operationId": "analyze",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze"
      }
    },
    "/v1/breaches": {
      "get": {
        "operationId": "breaches",
        "parameters": [
          {
            "in": "query",
            "name": "hostname",
            "required": true,
            "schema": {
              "maxLength": 254,
              "minLength": 1,
              "title": "Hostname",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BreachesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Breaches"
      }
    }
  }
}
