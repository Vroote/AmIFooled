# Only these inputs can enter either build context.
**
!package.json
!package-lock.json
!apps/
!apps/api/
!apps/api/Dockerfile
!apps/api/pyproject.toml
!apps/api/requirements-dev.lock
!apps/api/app/
!apps/api/app/**
!apps/extension/
!apps/extension/**

# Deny local/generated files even inside the allowed source trees.
**/.env
**/.env.*
**/.git
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.wxt
**/.output
**/.idea
**/.DS_Store
**/coverage
**/dist
